local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local lp = Players.LocalPlayer

-- ========== 配置参数 ==========
local segmentsPerSec = 1000 -- 默认初始值，范围0~1000
local stepDistance = 5 -- 默认瞬移距离
local verticalStep = 1.6
local maxFallY = -0.15
local enableWalkTP = true
local enableSlowFall = false
local lastWalkTP = 0
local verticalRate = 1 / 50 -- 上下固定50次/秒
-- ==============================

