textBoxDist.TextColor3 = Color3.new(0, 0, 0)
textBoxDist.Text = tostring(stepDistance)
textBoxDist.ClearTextOnFocus = false
textBoxDist.Parent = panel

local holdUp = false
local holdDown = false

settingBtn.MouseButton1Click:Connect(function()
	panel.Visible = not panel.Visible
end)

-- 每秒瞬移次数
textBoxSpeed.FocusLost:Connect(function()
	local num = tonumber(textBoxSpeed.Text)
	if num then
		num = math.clamp(num, 0, 1000)
		segmentsPerSec = num
	end
	textBoxSpeed.Text = tostring(segmentsPerSec)
end)

-- 瞬移距离
textBoxDist.FocusLost:Connect(function()
	local num = tonumber(textBoxDist.Text)
	if num and num >= 0 then
		stepDistance = num
	end
	textBoxDist.Text = tostring(stepDistance)
end)

toggleWalkBtn.MouseButton1Click:Connect(function()
	enableWalkTP = not enableWalkTP
	if enableWalkTP then
		toggleWalkBtn.Text = "瞬移:开"
	else
		toggleWalkBtn.Text = "瞬移:关"
	end
end)

toggleSlowFallBtn.MouseButton1Click:Connect(function()
	enableSlowFall = not enableSlowFall
	if enableSlowFall then
		toggleSlowFallBtn.Text = "慢落:开"
	else
		toggleSlowFallBtn.Text = "慢落:关"
	end
end)

btnUp.MouseButton1Down:Connect(function() holdUp = true end)
btnUp.MouseButton1Up:Connect(function() holdUp = false end)
btnUp.MouseLeave:Connect(function() holdUp = false end)

btnDown.MouseButton1Down:Connect(function() holdDown = true end)
btnDown.MouseButton1Up:Connect(function() holdDown = false end)
btnDown.MouseLeave:Connect(function() holdDown = false end)

local char, hum, hrp
local function refreshCharacter(newChar)
	task.wait(0.3)
	char = newChar
	hum = char:WaitForChild("Humanoid")
	hrp = char:WaitForChild("HumanoidRootPart")
end

lp.CharacterAdded:Connect(refreshCharacter)
if lp.Character then
	task.spawn(refreshCharacter, lp.Character)
end
lp.CharacterRemoving:Connect(function()
	char = nil
	hum = nil
	hrp = nil
end)

RunService.Heartbeat:Connect(function()
	if not hum or not hrp then return end
	local now = os.clock()
	local walkInterval = 1 / segmentsPerSec

	-- 走路高频瞬移：移动时也能叠加上下（原本的角色移动方向逻辑）
	if enableWalkTP then
		if hum.MoveDirection.Magnitude > 0.01 then
			if now - lastWalkTP >= walkInterval then
				lastWalkTP = now
				local moveDir = hum.MoveDirection
				moveDir = Vector3.new(moveDir.X, 0, moveDir.Z).Unit

				local targetPos = char:GetPivot() + moveDir * stepDistance

				if holdUp then
					targetPos += Vector3.new(0, verticalStep, 0)
				elseif holdDown then
					targetPos += Vector3.new(0, -verticalStep, 0)
				end

				char:PivotTo(targetPos)
			end
		else
			-- 原地长按上下
			if (holdUp or holdDown) and now - lastWalkTP >= verticalRate then
				lastWalkTP = now
				if holdUp then
					char:PivotTo(char:GetPivot() + Vector3.new(0, verticalStep, 0))
				elseif holdDown then
					char:PivotTo(char:GetPivot() + Vector3.new(0, -verticalStep, 0))
				end
			end
		end
	else
		-- 走路瞬移关闭，只保留上下
		if (holdUp or holdDown) and now - lastWalkTP >= verticalRate then
			lastWalkTP = now
			if holdUp then
				char:PivotTo(char:GetPivot() + Vector3.new(0, verticalStep, 0))
			elseif holdDown then
				char:PivotTo(char:GetPivot() + Vector3.new(0, -verticalStep, 0))
			end
		end
	end

	if enableSlowFall then
		if hum:GetState() == Enum.HumanoidStateType.Freefall then
			local vel = hrp.AssemblyLinearVelocity
			if vel.Y < maxFallY then
				hrp.AssemblyLinearVelocity = Vector3.new(vel.X, maxFallY, vel.Z)
			end
		end
	end
end)